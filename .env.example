# Optional. The ERP core runs offline without Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=

# Local SQLite data directory. Desktop packaging overrides this to the
# persistent per-user application-data directory.
FATHI_DATA_DIR=./data
PORT=3000

# Session security. Safe defaults are used when omitted.
# Absolute session lifetime: 30..1440 minutes (default 240 = 4 hours).
# Idle session lifetime: 5..240 minutes (default 20 minutes).
FATHI_SESSION_ABSOLUTE_MINUTES=240
FATHI_SESSION_INACTIVITY_MINUTES=20

# LAN is disabled by default. Enable only on a trusted network and set an
# explicit bind address; authentication remains required for every client.
FATHI_LAN_MODE=false
FATHI_LAN_HOST=
FATHI_SETUP_TOKEN=

# LAN bootstrap brute-force protection.
FATHI_BOOTSTRAP_WINDOW_MINUTES=15
FATHI_BOOTSTRAP_MAX_FAILURES=5

# Secure LAN transport. LAN mode requires a TLS key/certificate unless the
# operator explicitly accepts insecure HTTP for an isolated trusted network.
FATHI_LAN_TLS_KEY=
FATHI_LAN_TLS_CERT=
FATHI_LAN_ALLOW_INSECURE_HTTP=false

# Optional public URL used only by deployments that need external links.
APP_URL=
